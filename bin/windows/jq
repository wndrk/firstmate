#!/usr/bin/env bash
# bin/windows/jq - Git Bash shim for a native Windows jq.exe (docs/windows.md).
#
# A native jq.exe writes CRLF line endings unless it runs with -b/--binary,
# and every Firstmate caller splits jq output on LF and compares exact fields,
# so a stray CR would silently break ids, states, and paths. This shim runs
# the real jq with -b. bin/fm-windows-setup.sh records the real executable in
# FM_WINDOWS_JQ so the common path is one exec; without it the shim searches
# PATH for the next jq that is not a Firstmate shim. Any copy of this shim
# (another Firstmate checkout on PATH, or one recorded in FM_WINDOWS_JQ) is
# skipped by its header line, because exec'ing it would loop forever.
set -u
fm_jq_is_shim() {  # <file>
  case "$1" in *.exe|*.EXE) return 1 ;; esac
  head -c 512 "$1" 2>/dev/null | grep -q 'bin/windows/jq - Git Bash shim'
}
real=${FM_WINDOWS_JQ:-}
if [ -n "$real" ] && fm_jq_is_shim "$real"; then
  real=
fi
if [ -z "$real" ] || [ ! -x "$real" ]; then
  real=
  self_dir=$(cd "${BASH_SOURCE[0]%/*}" 2>/dev/null && pwd -P) || self_dir=
  IFS=: read -r -a fm_jq_dirs <<<"${PATH:-}"
  for dir in "${fm_jq_dirs[@]}"; do
    [ -n "$dir" ] || continue
    resolved=$(cd "$dir" 2>/dev/null && pwd -P) || continue
    [ "$resolved" != "$self_dir" ] || continue
    for candidate in "$dir/jq.exe" "$dir/jq"; do
      if [ -f "$candidate" ] && [ -x "$candidate" ] && ! fm_jq_is_shim "$candidate"; then
        real=$candidate
        break 2
      fi
    done
  done
fi
if [ -z "$real" ]; then
  echo "jq: no jq executable found on PATH besides the Firstmate Windows shim; install jq 1.7 or newer (winget install jqlang.jq)" >&2
  exit 127
fi
exec "$real" -b "$@"
